# ============================================================
# Elimu Hub Tanzania — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Security (REQUIRED — change before deploying!) ---
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# --- Database ---
DB_PASSWORD=secure_password_change_me

# --- URLs ---
# FRONTEND_URL: Set to * to allow all origins (recommended for Cloudflare/internet access)
# OR set to your specific domain: https://yourdomain.com
FRONTEND_URL=*

# Full API URL as seen by the browser
# Use /api for relative URL (works on ANY domain including Cloudflare tunnels)
# OR set to your domain: https://yourdomain.com/api
REACT_APP_API_URL=/api

# --- Optional: SSL ---
DB_SSL=false

# --- Node ---
NODE_ENV=production

# --- TIE AI (Tutor Intelligence Engine) ---
# Get your key from https://openrouter.ai/keys
# NEVER expose this key to the frontend — it stays here in the backend .env only.
# Drop your textbook PDFs in backend/books/ — see backend/books/README.md
OPENROUTER_API_KEY=your_openrouter_api_key_here
